# Backend image (Node). Build context: the api/ directory. The same shape works
# for an MCP server image (expose its port instead, e.g. 3000).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}
ENV NODE_ENV=production
COPY --from=build /app/package.json ./
# (Assumes runtime dependencies; with none, npm creates no node_modules.)
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# Copy any runtime files the build does not put in dist, for example:
# COPY --from=build /app/migrations ./migrations
# A numeric non-root user (the node image's "node" user is uid 1000).
USER 1000
EXPOSE 8080
# The server must listen on 0.0.0.0, not 127.0.0.1.
CMD ["node", "dist/server.js"]
